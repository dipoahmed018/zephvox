# Machine-specific environment for zephvox.
#
#   cp .env.example .env
#
# .env is git-ignored. It is read whenever zephvox starts, including from the app menu or a
# global shortcut, which don't see the exports in your shell profile. A variable that is already
# set in the environment wins over this file.

# --- AMD GPUs (ROCm) ---
# Needed when PyTorch doesn't recognise your GPU. RX 6000 series (gfx103x): 10.3.0, RX 7000 (gfx110x): 11.0.0
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# --- NVIDIA / AMD: choose a GPU when there are several ---
# CUDA_VISIBLE_DEVICES=0
# HIP_VISIBLE_DEVICES=0

# --- Where downloaded models are stored (default: ~/.cache/huggingface) ---
# HF_HOME=/mnt/big-disk/huggingface

# --- espeak plugin only: use another espeak-ng library than the one bundled with it ---
# PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/libespeak-ng.so

# --- Cloud LLM for grammar: set api_key_env = "OPENAI_API_KEY" in config.toml ---
# OPENAI_API_KEY=sk-...

# --- Paths (normally not needed) ---
# ZEPHVOX_CONFIG=/path/to/config.toml
# ZEPHVOX_HOME=/path/to/data
